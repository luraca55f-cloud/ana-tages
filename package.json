{
  "name": "ana-tages",
  "version": "2.0.4",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "verify:project": "node scripts/verify-project.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run verify:project && vite build && npm run typecheck",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run verify:project && npm run lint && npm run build",
    "format": "prettier --write ."
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@supabase/supabase-js": "2.117.0",
    "@tanstack/react-query": "5.101.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.575.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.1",
    "@eslint/js": "9.32.0",
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "22.16.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "15.15.0",
    "prettier": "3.7.3",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.56.1",
    "vite": "7.3.6",
    "wrangler": "4.136.2"
  }
}
