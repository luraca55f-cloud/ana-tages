{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ana-tages",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  // Preserva variáveis de runtime configuradas no painel (login de teste e token de leitura).
  "keep_vars": true,
  // Estes nomes são sincronizados a partir dos Build Variables/Secrets pelo script
  // scripts/sync-runtime-secrets.mjs antes do deploy. Os valores nunca ficam no Git.
  "secrets": {
    "required": [
      "TEST_LOGIN_EMAIL",
      "TEST_LOGIN_PASSWORD",
      "SUPABASE_PROJECT_REF",
      "SUPABASE_MANAGEMENT_TOKEN",
      "VAULT_RECOVERY_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "HTTP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  // Mantém no código a mesma observabilidade configurada no painel da Cloudflare.
  // Isso evita que um deploy pelo GitHub volte a divergir das opções de produção.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
