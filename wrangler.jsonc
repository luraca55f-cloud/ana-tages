{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ana-tages",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "ratelimits": [
    {
      "name": "HTTP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
