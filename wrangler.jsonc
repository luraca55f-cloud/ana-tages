{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ana-tages",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "ratelimits": [
    {
      "name": "HTTP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  // Mantém no código a mesma observabilidade configurada no painel da Cloudflare.
  // Isso evita que um deploy pelo GitHub volte a divergir das opções de produção.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
