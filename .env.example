# TAGES CONSULTORIA ANNA - CLEAN START
# Use SOMENTE chaves públicas do frontend neste arquivo/na build.
# Nunca coloque service_role, database password, Turnstile secret ou outros segredos em VITE_*.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL

# Compatibilidade opcional com instalações antigas. Em uma instalação nova, use a variável acima.
# VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile - SITE KEY pública. Pode ficar vazia no primeiro deploy.
VITE_TURNSTILE_SITE_KEY=

# Logout automático por inatividade: mínimo 5, máximo 120 minutos.
VITE_IDLE_TIMEOUT_MINUTES=30
